# Copy to .env for local development. Never commit real values.
# Every variable here is validated at boot by src/common/config/env.validation.ts.

NODE_ENV=development
PORT=4000

# Local: a replica set is needed for transactions (docs/DEPLOYMENT.md "Local MongoDB")
#   mongodb://localhost:27017/book_selling?replicaSet=rs0
# Production: MongoDB Atlas mongodb+srv:// URI
MONGODB_URI=mongodb://localhost:27017/book_selling

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Auth (docs/ARCHITECTURE.md §5) ----
# At least 32 random characters, different per environment:  openssl rand -base64 48
JWT_ACCESS_SECRET=
# Exactly 32 bytes, base64. Encrypts two-step verification secrets at rest:  openssl rand -base64 32
# Changing it later makes every enrolled authenticator unusable, so keep it safe and stable.
TWO_FACTOR_ENCRYPTION_KEY=
# Optional (defaults shown). BCRYPT_COST must be >= 12 in production.
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_COST=12

# ---- Brand (shown in emails) ----
BRAND_NAME=Engineering Books
# SUPPORT_EMAIL=support@example.com
# BUSINESS_POSTAL_ADDRESS=12 Campus Road, Lagos, Nigeria

# ---- Email (docs/ARCHITECTURE.md §11) ----
# Leave RESEND_API_KEY empty locally: emails are rendered and printed to the API log instead
# of being sent. All three of the next values are REQUIRED in production.
RESEND_API_KEY=
# Signing secret of the Resend webhook (whsec_...), from Resend → Webhooks
RESEND_WEBHOOK_SECRET=
# e.g. "Engineering Books <books@mail.yourdomain.com>" (a Resend-verified domain)
MAIL_FROM=
# MAIL_REPLY_TO=support@example.com
# Receives operational alerts (emails that could not be delivered)
# OWNER_ALERT_EMAIL=owner@example.com
