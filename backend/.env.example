# Copy to .env for local development. Never commit real values.
# Every variable here is validated at boot by src/common/config/env.validation.ts.

NODE_ENV=development
PORT=4000

# Local: a replica set is needed for transactions (docs/DEPLOYMENT.md "Local MongoDB")
#   mongodb://localhost:27017/book_selling?replicaSet=rs0
# Production: MongoDB Atlas mongodb+srv:// URI
MONGODB_URI=mongodb://localhost:27017/book_selling

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Auth (docs/ARCHITECTURE.md §5) ----
# At least 32 random characters, different per environment:  openssl rand -base64 48
JWT_ACCESS_SECRET=
# Exactly 32 bytes, base64. Encrypts two-step verification secrets at rest:  openssl rand -base64 32
# Changing it later makes every enrolled authenticator unusable, so keep it safe and stable.
TWO_FACTOR_ENCRYPTION_KEY=
# Optional (defaults shown). BCRYPT_COST must be >= 12 in production.
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_COST=12

# ---- Brand (shown in emails) ----
BRAND_NAME=Engineering Books
# SUPPORT_EMAIL=support@example.com
# BUSINESS_POSTAL_ADDRESS=12 Campus Road, Lagos, Nigeria

# ---- Email (docs/ARCHITECTURE.md §11) ----
# Leave RESEND_API_KEY empty locally: emails are rendered and printed to the API log instead
# of being sent. All three of the next values are REQUIRED in production.
RESEND_API_KEY=
# Signing secret of the Resend webhook (whsec_...), from Resend → Webhooks
RESEND_WEBHOOK_SECRET=
# e.g. "Engineering Books <books@mail.yourdomain.com>" (a Resend-verified domain)
MAIL_FROM=
# MAIL_REPLY_TO=support@example.com
# Receives operational alerts (emails that could not be delivered)
# OWNER_ALERT_EMAIL=owner@example.com

# ---- Cloudinary: covers, images and the private book PDFs (docs/ARCHITECTURE.md §10.0) ----
# From the Cloudinary console → Settings → API Keys. Required in production; locally, uploads
# answer 503 "not configured" until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Everything this environment uploads lives under this folder (and only it is ever cleaned up)
CLOUDINARY_FOLDER=book-selling/development
# Largest image accepted, in MB (the free Cloudinary plan allows 10)
# IMAGE_MAX_MB=10

# Book PDFs: Cloudflare R2, private (docs/ARCHITECTURE.md §10.0, setup in docs/DEPLOYMENT.md §4b).
# Cloudflare dashboard → R2 → your bucket; Manage API tokens → "Object Read & Write" for that bucket.
# Required in production; locally, book PDF uploads answer 503 "not configured" until set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Everything this environment uploads lives under this folder
R2_FOLDER=book-selling/development
# Only for another S3-compatible store (e.g. MinIO at http://127.0.0.1:9000); leave empty for R2
# R2_ENDPOINT=
# Largest book PDF accepted, in MB. Building a preview needs about 4x this in server memory.
# MANUSCRIPT_MAX_MB=200
# Largest share of a book the free preview may show, in percent (PRODUCT_RULES §4)
# PREVIEW_MAX_PERCENT=15

# ---- Storefront cache refresh ----
# Same value as the storefront's REVALIDATE_SECRET (16+ characters), so catalogue edits show
# at once. Without it, pages still refresh within 5 minutes.
# FRONTEND_REVALIDATE_SECRET=

# ---- Payments (docs/ARCHITECTURE.md §9, docs/DEPLOYMENT.md §6) ----
# test (default) or live. Live takes real money and belongs in production only. Every key below
# must match the mode: sk_test_… / FLWSECK_TEST-… in test, sk_live_… / FLWSECK-… in live.
# PAYMENTS_MODE=test
# A provider is offered to buyers only when its keys are set; leave a provider empty to switch it off.
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you type in the Flutterwave dashboard (Settings → Webhooks), 16+ characters
# FLUTTERWAVE_WEBHOOK_HASH=
# STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint, or "stripe listen" locally (whsec_…)
# STRIPE_WEBHOOK_SECRET=
