# Copy to .env.local for local development. Never commit real values.

# Server-only: absolute URL of the NestJS API. Used by the /api proxy rewrite and server-side
# fetches. Required in production; defaults to http://localhost:4000 in development.
API_URL=http://localhost:4000

# Public canonical URL of the storefront (SEO metadata, sitemap, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store name shown in the header, emails link back here
NEXT_PUBLIC_BRAND_NAME=Engineering Books
